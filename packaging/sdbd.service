[Unit]
Description=Sinty Debug Bridge daemon
# The owner opt-in is enforced by both the unit and sdbd. A release image ships
# the control surface, but no listener exists until the owner enables it.
ConditionPathExists=/var/lib/sinty-sdb/enabled
After=network.target
Wants=network.target

[Service]
Type=simple
Group=singularity-session
StateDirectory=sinty-sdb
ExecStart=/usr/bin/sdbd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
